# Copy to secrets.yaml next to kallsup-sendspin.yaml and fill in. secrets.yaml is gitignored.

wifi_ssid: "CHANGE_ME"
wifi_password: "CHANGE_ME"
fallback_password: "CHANGE_ME"          # the speaker's own hotspot if Wi-Fi fails

# Encrypts the ESPHome API and authenticates OTA uploads. Home Assistant asks for it
# when you adopt the speaker. Generate one: openssl rand -base64 32
# (32 bytes, base64; ESPHome refuses anything else)
api_encryption_key: "CHANGE_ME_KEY"
